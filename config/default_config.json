{
  "data": {
    "dict_file": "data/dict.csv",
    "data_x": "data/data_x.parquet",
    "data_y": "data/data_y.parquet",
    "join_keys": [
      "cust_no"
    ],
    "target_col": "label",
    "split_col": 202601,
    "month_col": "month",
    "id_cols": [
      "cust_no"
    ],
    "exclude_cols": null,
    "feature_cols": null,
    "clean_rules": [
      {
        "col_pattern": "f0",
        "values": [
          -999,
          -1111
        ]
      },
      {
        "col_pattern": "score",
        "values": [
          0
        ]
      }
    ],
    "date_cols": []
  },
  "screen_rules": [
    {
      "stat": "missing_rate",
      "op": "<=",
      "value": 0.95,
      "level": "exclude"
    },
    {
      "stat": "single_value_rate",
      "op": "<=",
      "value": 0.99,
      "level": "exclude"
    },
    {
      "stat": "iv_total",
      "op": ">=",
      "value": 0.02,
      "level": "exclude"
    },
    {
      "stat": "iv_train_test",
      "op": ">=",
      "value": 0.02,
      "level": "exclude"
    },
    {
      "stat": "iv_oot",
      "op": ">=",
      "value": 0.02,
      "level": "exclude"
    },
    {
      "stat": "iv_decay_rate",
      "op": "<=",
      "value": 0.5,
      "level": "warn"
    },
    {
      "stat": "psi_train_test_vs_oot",
      "op": "<=",
      "value": 0.25,
      "level": "exclude"
    },
    {
      "stat": "psi_adjacent_month_max",
      "op": "<=",
      "value": 0.25,
      "level": "exclude"
    },
    {
      "stat": "psi_vs_first_month_max",
      "op": "<=",
      "value": 0.25,
      "level": "exclude"
    },
    {
      "stat": "psi_vs_last_month_max",
      "op": "<=",
      "value": 0.25,
      "level": "exclude"
    },
    {
      "stat": "psi_*",
      "op": "<=",
      "value": 0.1,
      "level": "warn"
    },
    {
      "stat": "gain_ratio",
      "op": ">=",
      "value": 0.001,
      "level": "exclude"
    }
  ],
  "screen_options": {
    "drop_low_importance": false
  },
  "binning": {
    "iv_init_bins": 100,
    "iv_max_bins": 6,
    "psi_bins": 10,
    "eval_bins": 10
  },
  "corr": {
    "corr_cluster_r": 0.8,
    "cluster_representative": "iv"
  },
  "lgbm": {
    "pre_model_params": {
      "bagging_fraction": 0.7,
      "bagging_freq": 1,
      "feature_fraction": 0.7,
      "lambda_l1": 20,
      "lambda_l2": 20,
      "learning_rate": 0.05,
      "max_depth": 2,
      "metric": "auc",
      "min_data_in_leaf": 500,
      "n_jobs": 1,
      "num_leaves": 4,
      "num_threads": 1,
      "objective": "binary",
      "seed": 42,
      "deterministic": true,
      "verbosity": -1
    }
  },
  "search": {
    "n_trials": 100,
    "objective": "0.5*test_auc + 0.5*test_ks",
    "auc_gap_max": 0.05,
    "sampler_seed": 42,
    "search_space": {
      "num_leaves": [
        15,
        127,
        "int"
      ],
      "max_depth": [
        3,
        8,
        "int"
      ],
      "learning_rate": [
        0.01,
        0.15,
        "log"
      ],
      "min_child_samples": [
        20,
        200,
        "int"
      ],
      "feature_fraction": [
        0.5,
        1.0,
        "uniform"
      ],
      "bagging_fraction": [
        0.5,
        1.0,
        "uniform"
      ],
      "bagging_freq": [
        1,
        7,
        "int"
      ],
      "reg_alpha": [
        1e-08,
        10,
        "log"
      ],
      "reg_lambda": [
        1e-08,
        10,
        "log"
      ]
    }
  },
  "peek_rows": 5,
  "top_n_trials": 20,
  "max_retries": 2
}
